[Unit]
Description=Fuel MAX bot (webhook)
After=network.target

[Service]
User=fuel
Group=fuel
WorkingDirectory=/opt/fuel_bot
EnvironmentFile=/opt/fuel_bot/.env
ExecStart=/opt/fuel_bot/venv/bin/uvicorn max_bot.app:app --host 127.0.0.1 --port 9001 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

