[Unit]
Description=Fuel calculator web (FastAPI)
After=network.target

[Service]
User=fuel
Group=fuel
WorkingDirectory=/opt/fuel_bot
EnvironmentFile=/opt/fuel_bot/.env
ExecStart=/opt/fuel_bot/venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
